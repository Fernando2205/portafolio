---
/*
  Todas las secciones del sitio, en orden. Las dos páginas (/ y /en/) montan
  este mismo componente: el idioma se deduce de la URL dentro de cada pieza,
  así que la lista de secciones vive en un solo archivo.

  Las <section> van con `relative z-1` y fondo transparente para que el canvas
  3D fijo se vea por detrás.
*/
import Cinta from './Cinta.astro'
import Contacto from './Contacto.astro'
import Cursor from './Cursor.astro'
import Loader from './Loader.astro'
import Hero from './Hero.astro'
import Logros from './Logros.astro'
import Nav from './Nav.astro'
import Proyectos from './Proyectos.astro'
import Sobre from './Sobre.astro'
import Stack from './Stack.astro'
import Terminal from './Terminal.astro'
import Trayectoria from './Trayectoria.astro'
---

<Loader />
<Cursor />
<Nav />

<main id="contenido">
  <Hero />
  <Cinta />
  <Sobre />
  <Trayectoria />
  <Logros />
  <Proyectos />
  <Terminal />
  <Stack />
  <Contacto />
</main>
