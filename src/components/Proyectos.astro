---
import { Image, getImage } from 'astro:assets'
import { capturasDe } from '../data/imagenes'
import { PROYECTOS } from '../data/proyectos'
import { getLang, t } from '../i18n/utils'
import PreviewProyecto from './PreviewProyecto.astro'
import VisorCaptura from './VisorCaptura.astro'

const lang = getLang(Astro.url)
const dic = t(lang)

/*
  Versión grande de cada captura para el visor (gallery.ts). Se genera aquí, en
  el build, y viaja en `data-galeria` de la fila; el navegador solo la pide al
  abrir el visor.
*/
const ANCHO_VISOR = 2400
const galerias = Object.fromEntries(
  await Promise.all(
    PROYECTOS.map(async proyecto => {
      const grandes = await Promise.all(
        capturasDe(proyecto.slug).map(async captura => {
          const ancho = Math.min(captura.width, ANCHO_VISOR)
          const imagen = await getImage({ src: captura, width: ancho, format: 'webp' })
          return { src: imagen.src, ancho, alto: Math.round(ancho * captura.height / captura.width) }
        })
      )
      return [proyecto.slug, grandes] as const
    })
  )
)

const RAYAS =
  'repeating-linear-gradient(135deg,rgba(255,255,255,.07) 0 1px,transparent 1px 11px)'
---

<section id="proyectos" class="relative z-1 border-t border-line pad-x pad-y">
  <div class="mb-12 flex flex-wrap items-end justify-between gap-4">
    <div class="flex flex-col gap-4">
      <div data-scramble class="font-mono text-[13px] text-mut">{dic.proyectos.etiqueta}</div>
      <div class="overflow-hidden pb-[.1em]">
        <h2 data-h class="text-h2">{dic.proyectos.titulo}</h2>
      </div>
    </div>
    <div data-reveal class="font-mono text-[13px] text-mut">{dic.proyectos.pista}</div>
  </div>

  <div data-lista-proyectos class="border-t border-line">
    {
      PROYECTOS.map((proyecto, i) => {
        const capturas = capturasDe(proyecto.slug)
        const captura = capturas[0]
        const idPanel = `proyecto-panel-${proyecto.slug}`

        /*
          La caja toma la proporción de la captura, así que se ve entera y sin
          recortes, sea cual sea.

          Las verticales (capturas de móvil) se tratan aparte: a lo ancho de la
          columna una proporción de 0.47 daría más de 1000px de alto. En vez de
          estirar la caja, se le fija el alto y el ancho sale de la proporción,
          con lo que queda centrada y del tamaño de un teléfono.
        */
        const proporcion = captura ? captura.width / captura.height : 16 / 10
        const vertical = proporcion < 1
        /* Con dos capturas verticales se montan en collage, que llena el ancho
           que una sola captura de móvil deja vacío. */
        const collage = vertical && capturas.length > 1

        return (
          <div
            data-row
            data-slug={proyecto.slug}
            data-nombre={proyecto.nombre}
            data-galeria={capturas.length > 0 ? JSON.stringify(galerias[proyecto.slug]) : undefined}
            class="cursor-pointer border-b border-line"
            style="padding:clamp(20px,3vw,32px) 0"
          >
            <div class="flex flex-wrap items-baseline gap-x-6 gap-y-2">
              <span class="w-8 font-mono text-[13px] text-mut">
                {String(i + 1).padStart(2, '0')}
              </span>

              <h3
                data-nombre
                class="flex-1 basis-[300px] text-proyecto"
                style="transition:transform .45s var(--ease-suave),color .3s,font-variation-settings .45s"
              >
                {proyecto.nombre}
              </h3>

              <span class="font-mono text-[13px] text-mut">
                {`${proyecto.tipo[lang]} — ${proyecto.anio}`}
              </span>

              <button
                type="button"
                data-mas-proyecto
                aria-expanded="false"
                aria-controls={idPanel}
                aria-label={`${dic.cursor.abrir} ${proyecto.nombre}`}
                data-cursor={dic.cursor.abrir}
                class="w-5 cursor-pointer border-0 bg-transparent p-0 text-right font-mono text-xl text-acct"
                style="transition:transform .4s"
              >
                +
              </button>
            </div>

            <div
              id={idPanel}
              data-panel
              hidden
              class="grid gap-8"
              style="grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr));padding:32px 0 8px clamp(0px,4vw,56px)"
            >
              {collage
                ? (
                    <div class="flex h-[min(620px,70vh)] w-full items-end justify-center">
                      {capturas.slice(0, 2).map((imagen, orden) => (
                        <button
                          type="button"
                          data-ampliar={orden}
                          aria-label={`${dic.proyectos.ampliar} · ${proyecto.nombre} ${orden + 1}`}
                          data-cursor={dic.cursor.ampliar}
                          class:list={[
                            'cursor-zoom-in border-0 bg-transparent p-0 transition-transform duration-300 ease-suave hover:scale-[1.02]',
                            orden === 0 ? 'h-[88%] -rotate-3' : 'z-10 -ml-14 h-full rotate-2'
                          ]}
                        >
                          <Image
                            src={imagen}
                            alt={`${dic.proyectos.captura} · ${proyecto.nombre}`}
                            widths={[320, 640]}
                            sizes="320px"
                            class="h-full w-auto rounded-preview border border-line object-cover shadow-toast"
                          />
                        </button>
                      ))}
                    </div>
                  )
                : (
                    <div
                      class:list={[
                        'relative overflow-hidden rounded-preview',
                        vertical ? 'mx-auto h-[min(760px,76vh)] w-auto' : 'w-full'
                      ]}
                      style={`aspect-ratio:${proporcion};background:${proyecto.tinte}`}
                    >
                      {captura
                        ? (
                            <button
                              type="button"
                              data-ampliar="0"
                              aria-label={`${dic.proyectos.ampliar} · ${proyecto.nombre}`}
                              data-cursor={dic.cursor.ampliar}
                              class="group block h-full w-full cursor-zoom-in border-0 bg-transparent p-0"
                            >
                              <Image
                                src={captura}
                                alt={`${dic.proyectos.captura} · ${proyecto.nombre}`}
                                widths={[480, 960]}
                                sizes="(max-width: 640px) 100vw, 480px"
                                class="h-full w-full object-cover transition-transform duration-500 ease-suave group-hover:scale-[1.03]"
                              />
                              {capturas.length > 1 && (
                                <span class="absolute right-3 bottom-3 rounded-full bg-black/60 px-2.5 py-1 font-mono text-[11px] text-[#efe7dc]">
                                  {`+${capturas.length - 1}`}
                                </span>
                              )}
                            </button>
                          )
                        : (
                            <>
                              <div class="absolute inset-0" style={`background:${RAYAS}`}></div>
                              <div
                                class="absolute bottom-3.5 left-4 font-mono text-xs"
                                style="color:#efe7dc"
                              >
                                {`${dic.proyectos.captura} · ${proyecto.nombre}`}
                              </div>
                            </>
                          )}
                    </div>
                  )}

              <div class="flex flex-col gap-5">
                {proyecto.distintivo && (
                  <div
                    class="self-start rounded-full bg-acc px-3.5 py-1.5 font-mono text-xs font-medium text-onacc"
                  >
                    {proyecto.distintivo[lang]}
                  </div>
                )}

                <p class="max-w-[52ch] text-[clamp(17px,1.5vw,20px)] leading-[1.5]">
                  {proyecto.descripcion[lang]}
                </p>

                <div class="flex flex-wrap gap-2">
                  {proyecto.etiquetas.map(etiqueta => (
                    <span
                      class="rounded-full border border-line px-3 py-[5px] font-mono text-xs text-mut"
                    >
                      {etiqueta}
                    </span>
                  ))}
                </div>

                <div class="flex flex-wrap items-baseline gap-x-7 gap-y-3 font-mono text-sm">
                  {proyecto.url && (
                    <a
                      href={proyecto.url}
                      target="_blank"
                      rel="noreferrer"
                      data-cursor={dic.cursor.ver}
                      class="text-acct"
                    >
                      {`${dic.proyectos.verProyecto} ↗`}
                    </a>
                  )}
                  {proyecto.repo && (
                    <a
                      href={proyecto.repo}
                      target="_blank"
                      rel="noreferrer"
                      data-cursor={dic.cursor.ver}
                      class="text-acct"
                    >
                      {`${dic.proyectos.codigo} ↗`}
                    </a>
                  )}
                </div>
              </div>
            </div>
          </div>
        )
      })
    }
  </div>
</section>

<PreviewProyecto />
<VisorCaptura />

<noscript>
  <style>
    [data-row] [data-panel] { display: grid !important; }
  </style>
</noscript>
